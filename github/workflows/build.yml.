name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - name: Unzip project
        run: unzip -q pointage-nfc.zip -d src
      - name: Build
        run: gradle assembleDebug -p src/pointage-nfc
      - uses: actions/upload-artifact@v4
        with:
          name: pointage-apk
          path: src/pointage-nfc/app/build/outputs/apk/debug/app-debug.apk
